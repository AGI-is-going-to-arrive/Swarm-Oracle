# Docker Compose runtime template.
# Copy this file to .env.docker for local overrides. Keep real secrets out of git.
#
# docker-compose.yml supplies durable /data paths, HOST, PORT, and CORS defaults.
# Default compose publishes both frontend and backend on 127.0.0.1 only.
# Before changing docker-compose.yml ports to public bindings, set ENV=production
# and fill unique SESSION_SECRET and ADMIN_TOKEN values below.
# ENV=production

# LLM provider as seen from inside the backend container.
# Docker Desktop: host.docker.internal usually resolves automatically.
# Linux: keep the compose host-gateway mapping, or replace with an explicit host IP.
# The shipped host.docker.internal:8317 + empty key is an unconfigured sentinel.
# Replace it with the actual service, or save the connection explicitly in /admin/setup.
LLM_RESPONSES_URL=http://host.docker.internal:8317/v1
LLM_API_KEY=
LLM_MODEL_NAME=gpt-5.4-mini
LLM_REASONING_EFFORT=none
LLM_REQUESTS_PER_MINUTE=0
LLM_TOKENS_PER_MINUTE=0

# Simulation defaults.
MAX_AGENTS=1500
MAX_ROUNDS=40
MAX_BRANCHES=8
# Runtime-lock lease for live simulation background tasks.
SIMULATION_LOCK_LEASE_SECONDS=120
# Seconds without content/progress activity before a live run is treated as stalled.
SIMULATION_STALL_TIMEOUT_SECONDS=900
# Stale-activity window for polling reads and startup recovery.
SIMULATION_STALE_ACTIVITY_LIMIT_SECONDS=900
# These global Agent-turn limits apply equally to localhost and remote providers.
# Restart the backend after changes; the 900-second stall watchdog remains the upper bound.
# Slow local models may need separate generation, metadata, and whole-turn budgets (seconds).
AGENT_TURN_GENERATION_REQUEST_TIMEOUT_SECONDS=45
AGENT_TURN_METADATA_REQUEST_TIMEOUT_SECONDS=120
AGENT_TURN_TOTAL_TIMEOUT_SECONDS=180
DEFAULT_NUM_AGENTS=20
DEFAULT_ROUNDS=10
MEMORY_COMPRESS_INTERVAL=5
BRANCH_PRUNE_THRESHOLD=0.05
FORK_SENSITIVITY=0.7

# Concurrency.
LLM_CONCURRENCY=5
LLM_MAX_PENDING=24
LLM_USER_MAX_PENDING=4
LLM_CIRCUIT_BREAKER_THRESHOLD=6
LLM_CIRCUIT_BREAKER_RESET_SECONDS=30
DEBATE_USE_LLM=true

# Set both values before exposing Docker deployment outside this machine.
# Generate each value with: openssl rand -hex 32
SESSION_SECRET=
ADMIN_TOKEN=

# User-facing features that are expected to be on in the local Docker profile.
FEATURE_CUSTOM_AGENTS=true
FEATURE_AGENT_IDENTITY=true
FEATURE_CAUSAL_GRAPH=true
FEATURE_GRAPH_ANALYSIS=true
FEATURE_COUNTERFACTUAL_REPLAY=true
FEATURE_FACTIONS=true
FEATURE_ARGUMENT_MAP=true
FEATURE_KG_EXPLORER=true
FEATURE_REPLAY_TRACE=true
FEATURE_AGENT_CONVERSATION=true
FEATURE_ROUNDTABLE_SURVEY=true
FEATURE_ROUNDTABLE_ANALYST=true
FEATURE_SNAPSHOT_EXPORT=true
FEATURE_PREDICTION_JOURNAL=true
FEATURE_RESULT_VERDICT=true
FEATURE_EDUCATION_TEMPLATES=true
FEATURE_PERSONA_EXPORT=true
FEATURE_RESULT_REPORT=true
FEATURE_PUBLIC_ARTIFACTS=true
FEATURE_MULTI_RUN=true
FEATURE_YOU_VS_ORACLE=true
FEATURE_SOCIAL_HEADLINES=true
FEATURE_DOCUMENT_SEED=true
FEATURE_LOCAL_PACKS=true
FEATURE_MODEL_PROFILES=true

# Result report and short LLM-call tuning. Defaults match backend/app/config.py.
REPORT_MAX_SECTIONS=5
REPORT_MIN_SECTIONS=2
REPORT_MAX_TOOL_CALLS_PER_SECTION=3
REPORT_MIN_TOOL_CALLS_PER_SECTION=2
REPORT_SECTION_TIMEOUT_SECONDS=120
REPORT_RUNTIME_LOCK_LEASE_SECONDS=120
REPORT_PLAN_TIMEOUT_SECONDS=20
REPORT_MAX_EVIDENCE_PER_SECTION=5
REPORT_SECTION_CONTENT_MAX_CHARS=12000
REPORT_FULL_REPORT_MAX_BYTES=262144
REPORT_EVIDENCE_EXCERPT_MAX_CHARS=600
RESULT_VERDICT_REQUEST_TIMEOUT_SECONDS=45
RESULT_VERDICT_TOTAL_TIMEOUT_SECONDS=50
NARRATION_REQUEST_TIMEOUT_SECONDS=35
NARRATION_TOTAL_TIMEOUT_SECONDS=40
NARRATION_STREAM_PROBE_TIMEOUT_SECONDS=8

# Backend-only behavior flags stay off by default.
FEATURE_ROUNDTABLE_INSIGHT_LLM=false
FEATURE_HALLUCINATION_GATE=false
FEATURE_IDENTITY_COMPACTION=false

# Web search is opt-in and requires a provider configuration.
ENABLE_WEB_SEARCH=false
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
XAI_WEB_SEARCH_MODEL=grok-4.20-reasoning
XAI_WEB_SEARCH_TIMEOUT_SECONDS=45
SEARXNG_URL=http://localhost:8888
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_CACHE_TTL_SECONDS=300
FEATURE_NEW_SOURCES=false
FEATURE_FAMILY_QUERY_OPTIMIZATION=false
