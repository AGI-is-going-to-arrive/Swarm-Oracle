# Local backend/dev template.
# For Docker Compose defaults, use `.env.docker`.
#
# ── LLM Configuration ────────────────────────────────
# 你的 LLM 服务地址（支持任何 OpenAI 兼容 API）
# 例如: OpenAI https://api.openai.com/v1 | Ollama http://127.0.0.1:11434/v1
LLM_RESPONSES_URL=https://api.openai.com/v1
# 你的 API Key
LLM_API_KEY=your-api-key-here
# 模型名称（取决于你的 LLM 服务）
# 例如: gpt-4o, deepseek-chat, qwen-plus
LLM_MODEL_NAME=gpt-4o
LLM_REASONING_EFFORT=none
LLM_REQUESTS_PER_MINUTE=0
LLM_TOKENS_PER_MINUTE=0

# ── Simulation Parameters ────────────────────────────
MAX_AGENTS=1500
MAX_ROUNDS=40
MAX_BRANCHES=8
MEMORY_COMPRESS_INTERVAL=5
# Developer-only memory compression budgets.
# These are backend tuning knobs, not end-user settings.
MEMORY_COMPRESS_MAX_RAW_WINDOW_CHARS=20000
MEMORY_COMPRESS_RECENT_RAW_WINDOW_CHARS=12000
MEMORY_COMPRESS_OVERFLOW_SUMMARY_SOURCE_CHARS=12000
MEMORY_CORE_MAX_RECENT=12
MEMORY_IMPORTANT_MAX_RECENT=5
MEMORY_CROWD_MAX_RECENT=3
MEMORY_CORE_CONTEXT_MAX_CHARS=4200
MEMORY_IMPORTANT_CONTEXT_MAX_CHARS=3000
BRANCH_PRUNE_THRESHOLD=0.05
FORK_SENSITIVITY=0.7
# DEFAULT_NUM_AGENTS: Default agent count when user doesn't specify (range 3-1500)
DEFAULT_NUM_AGENTS=20
# DEFAULT_ROUNDS: Default simulation rounds when user doesn't specify
DEFAULT_ROUNDS=10

# ── Concurrency ──────────────────────────────────────
LLM_CONCURRENCY=5
LLM_MAX_PENDING=24
LLM_USER_MAX_PENDING=4
LLM_CIRCUIT_BREAKER_THRESHOLD=6
LLM_CIRCUIT_BREAKER_RESET_SECONDS=30
DEBATE_USE_LLM=true

# ── Database ─────────────────────────────────────────
DATABASE_URL=sqlite:///./swarmoracle.db
CHROMA_PERSIST_DIR=./chroma_data

# ── Server ───────────────────────────────────────────
HOST=0.0.0.0
PORT=18927
CORS_ORIGINS=["http://localhost:5173","http://localhost:9528","http://localhost:18928"]

# ── Security — Session Gate (dev-only coarse gate) ───
# 为空时跳过鉴权（本地开发默认行为）。
# 设置后: REST 端点要求 X-Session-Token header,
#         WebSocket 连接要求首帧 auth `{"type":"auth","token":"..."}`。
# ⚠️ 临时开发态全局门禁，不是 owner-aware auth。
SESSION_SECRET=

# ── 功能开关 (Feature Flags) ─────────────────────────
# 下面这组默认开启，对应 README 里宣传的核心玩法，
# 与 .env.docker 保持一致，开箱即可体验。
FEATURE_COUNTERFACTUAL_REPLAY=true   # 反事实对比（改一句话，重新推演看差异）
FEATURE_CAUSAL_GRAPH=true            # 因果图谱（可视化事件因果关系）
FEATURE_FACTIONS=true                # 阵营关系（识别结盟与背叛）
FEATURE_ARGUMENT_MAP=true            # 论点地图（辩论的论证结构）
#
# 下面这组属于进阶/实验功能，默认关闭，需要时再设为 true。
FEATURE_CUSTOM_AGENTS=false          # 自定义 Agent 工坊
FEATURE_AGENT_IDENTITY=false         # 跨场景 Agent 身份记忆
FEATURE_PREDICTION_JOURNAL=false     # 预测记录册
FEATURE_HALLUCINATION_GATE=false     # 事实性校验闸
FEATURE_EDUCATION_TEMPLATES=false    # 教学模板
FEATURE_PERSONA_EXPORT=false         # 人物档案导出
FEATURE_REPLAY_TRACE=false           # 回放轨迹
FEATURE_AGENT_CONVERSATION=false     # 圆桌 Deep Dive：与单个代表私聊
FEATURE_ROUNDTABLE_SURVEY=false      # 圆桌 Deep Dive：多代表问卷质询
FEATURE_ROUNDTABLE_ANALYST=false     # 圆桌 Deep Dive：研究分析师
FEATURE_KG_EXPLORER=false            # 知识图谱浏览器
FEATURE_ROUNDTABLE_INSIGHT_LLM=false # 圆桌阶段要点用 LLM 重写

# ── Web Search Enhancement (搜索增强推演) ────────────
# 总开关（默认关闭，opt-in）
ENABLE_WEB_SEARCH=false
# 搜索提供商: tavily | exa | firecrawl | xai | searxng
WEB_SEARCH_PROVIDER=tavily
# 搜索 API Key（searxng 不需要）
WEB_SEARCH_API_KEY=
# xAI provider 使用的模型（仅 WEB_SEARCH_PROVIDER=xai 时）
XAI_WEB_SEARCH_MODEL=grok-4.20-reasoning
# xAI provider 搜索超时（秒）
XAI_WEB_SEARCH_TIMEOUT_SECONDS=45
# SearXNG 实例地址（仅 WEB_SEARCH_PROVIDER=searxng 时）
SEARXNG_URL=http://localhost:8888
# 调优参数
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_CACHE_TTL_SECONDS=300
