# 本地后端/开发模板。
# Docker Compose 默认值见 `.env.docker`。
#
# ── LLM 配置 ─────────────────────────────────────────
# 你的 LLM 服务地址（支持任何 OpenAI 兼容 API）
# 例如: OpenAI https://api.openai.com/v1 | Ollama http://127.0.0.1:11434/v1
LLM_RESPONSES_URL=https://api.openai.com/v1
# 你的 API Key
LLM_API_KEY=your-api-key-here
# 模型名称（取决于你的 LLM 服务）
# 例如: gpt-5.4-mini；其它服务请填写 provider 的实际模型 ID
LLM_MODEL_NAME=gpt-5.4-mini
LLM_REASONING_EFFORT=none
LLM_REQUESTS_PER_MINUTE=0
LLM_TOKENS_PER_MINUTE=0

# ── 推演参数 ─────────────────────────────────────────
MAX_AGENTS=1500
MAX_ROUNDS=40
MAX_BRANCHES=8
# 后台推演 runtime lock 租期（秒）；普通使用一般不用改。
SIMULATION_LOCK_LEASE_SECONDS=120
# 推演无任何内容/进度活动超过该秒数后，后台任务会按 stall 收敛。
SIMULATION_STALL_TIMEOUT_SECONDS=900
# 轮询/启动恢复判定 stale activity 的窗口（秒）。
SIMULATION_STALE_ACTIVITY_LIMIT_SECONDS=900
MEMORY_COMPRESS_INTERVAL=5
# 兼容字段：当前有效压缩间隔仍由 MEMORY_COMPRESS_INTERVAL 决定。
MEMORY_COMPRESS_SHORT_BRANCH_INTERVAL=2
MEMORY_COMPRESS_SHORT_BRANCH_MAX_ROUNDS=4
# 开发/运维用记忆压缩预算；普通使用一般不用改。
MEMORY_COMPRESS_MAX_RAW_WINDOW_CHARS=20000
MEMORY_COMPRESS_RECENT_RAW_WINDOW_CHARS=12000
MEMORY_COMPRESS_OVERFLOW_SUMMARY_SOURCE_CHARS=12000
MEMORY_CORE_MAX_RECENT=12
MEMORY_IMPORTANT_MAX_RECENT=5
MEMORY_CROWD_MAX_RECENT=3
MEMORY_CORE_CONTEXT_MAX_CHARS=4200
MEMORY_IMPORTANT_CONTEXT_MAX_CHARS=3000
BRANCH_PRUNE_THRESHOLD=0.05
FORK_SENSITIVITY=0.7
# 用户不指定时的默认 Agent 数（范围 3-1500）
DEFAULT_NUM_AGENTS=20
# 用户不指定时的默认推演轮数
DEFAULT_ROUNDS=10

# ── 并发 ─────────────────────────────────────────────
LLM_CONCURRENCY=5
LLM_MAX_PENDING=24
LLM_USER_MAX_PENDING=4
LLM_CIRCUIT_BREAKER_THRESHOLD=6
LLM_CIRCUIT_BREAKER_RESET_SECONDS=30
DEBATE_USE_LLM=true

# ── 数据库 ───────────────────────────────────────────
DATABASE_URL=sqlite:///./swarmoracle.db
CHROMA_PERSIST_DIR=./chroma_data

# ── 服务 ─────────────────────────────────────────────
# 默认开发模式允许空鉴权密钥，启动时仅打印 warning，便于本地开箱运行。
# Docker 容器通常需要 HOST=0.0.0.0；默认 docker-compose 只把前端和后端
# 端口发布到 127.0.0.1，因此仍是本机可访问。
# 生产或公网部署必须显式修改 docker-compose.yml 的端口发布绑定，
# 设置 ENV=production，并配置 SESSION_SECRET 和 ADMIN_TOKEN；
# 生产模式下空密钥会 fail-fast 阻止启动。
ENV=development
HOST=127.0.0.1
PORT=18927
CORS_ORIGINS=["http://localhost:5173","http://localhost:9528","http://localhost:18928"]

# ── 安全：会话门禁与管理端点 ─────────────────────────
# 为空时跳过鉴权（本地开发默认行为）。
# 设置后: REST 端点要求 X-Session-Token header,
#         WebSocket 连接要求首帧 auth `{"type":"auth","token":"..."}`。
# 开发/默认模式可留空；生产/公网部署必须设置 ENV=production 和 SESSION_SECRET。
# 如果将 Docker Compose 端口改成公网绑定，也必须设置该值。
# 分别为 SESSION_SECRET 和 ADMIN_TOKEN 生成唯一的 64 位十六进制值:
#   openssl rand -hex 32
# 切勿复用任何示例或公开值。
# ⚠️ 这是临时的全局粗粒度门禁，不是完整的多用户权限系统。
SESSION_SECRET=
# 为空时 /api/admin/* 开放（本地开发默认行为）。
# 生产/公网部署必须设置，并在管理请求中发送 X-Admin-Token header。
# 如果将 Docker Compose 端口改成公网绑定，也必须设置该值。
ADMIN_TOKEN=

# ── 功能开关 ─────────────────────────────────────────
# 默认开启的用户功能。
FEATURE_CUSTOM_AGENTS=true           # 自定义 Agent 工坊
FEATURE_AGENT_IDENTITY=true          # 跨场景 Agent 身份记忆
FEATURE_CAUSAL_GRAPH=true            # 因果图谱（可视化事件因果关系）
FEATURE_GRAPH_ANALYSIS=true          # 图谱分析（需要 FEATURE_CAUSAL_GRAPH=true 才生效）
FEATURE_COUNTERFACTUAL_REPLAY=true   # 反事实对比（改一句话，重新推演看差异）
FEATURE_FACTIONS=true                # 阵营关系（识别结盟与背叛）
FEATURE_ARGUMENT_MAP=true            # 论点地图（辩论的论证结构）
FEATURE_KG_EXPLORER=true             # 知识图谱浏览器
FEATURE_REPLAY_TRACE=true            # 回放轨迹
FEATURE_AGENT_CONVERSATION=true      # 与单个 Agent 追问
FEATURE_ROUNDTABLE_SURVEY=true       # 圆桌多代表问卷质询
FEATURE_ROUNDTABLE_ANALYST=true      # 圆桌研究分析师
FEATURE_SNAPSHOT_EXPORT=true         # 快照导入/导出
FEATURE_PREDICTION_JOURNAL=true      # 预测记录册
FEATURE_RESULT_VERDICT=true          # 结果页结论
FEATURE_EDUCATION_TEMPLATES=true     # 教学模板
FEATURE_PERSONA_EXPORT=true          # 人物档案导入/导出
#
FEATURE_RESULT_REPORT=true           # 结果页完整报告
FEATURE_PUBLIC_ARTIFACTS=true        # 脱敏公开分享 artifact / gallery
FEATURE_MULTI_RUN=true               # 多次推演分布
FEATURE_YOU_VS_ORACLE=true           # 用户预测与 Oracle 对比
FEATURE_SOCIAL_HEADLINES=true        # 社交动态和标题卡
FEATURE_DOCUMENT_SEED=true           # 文档种子上下文
FEATURE_LOCAL_PACKS=true             # 本地场景包
FEATURE_MODEL_PROFILES=true          # 模型配置档案
REPORT_MAX_SECTIONS=5
REPORT_MIN_SECTIONS=2
REPORT_MAX_TOOL_CALLS_PER_SECTION=3
REPORT_MIN_TOOL_CALLS_PER_SECTION=2
REPORT_SECTION_TIMEOUT_SECONDS=120
REPORT_RUNTIME_LOCK_LEASE_SECONDS=120
REPORT_PLAN_TIMEOUT_SECONDS=20
REPORT_MAX_EVIDENCE_PER_SECTION=5
REPORT_SECTION_CONTENT_MAX_CHARS=12000
REPORT_FULL_REPORT_MAX_BYTES=262144
REPORT_EVIDENCE_EXCERPT_MAX_CHARS=600
#
# 纯后端行为开关默认保持关闭；不是直接用户入口。
FEATURE_ROUNDTABLE_INSIGHT_LLM=false # 圆桌阶段要点用 LLM 重写
FEATURE_HALLUCINATION_GATE=false     # 事实性校验闸
FEATURE_IDENTITY_COMPACTION=false    # 身份记忆压缩

# ── 搜索增强推演 ─────────────────────────────────────
# 只有配置好搜索服务后再打开。托管搜索提供商通常需要 WEB_SEARCH_API_KEY；
# searxng 需要可访问的 SEARXNG_URL。
ENABLE_WEB_SEARCH=false
# 搜索提供商: tavily | exa | firecrawl | xai | searxng
WEB_SEARCH_PROVIDER=tavily
# 搜索 API Key（searxng 不需要）
WEB_SEARCH_API_KEY=
# xAI 搜索提供商使用的模型（仅 WEB_SEARCH_PROVIDER=xai 时）
XAI_WEB_SEARCH_MODEL=grok-4.20-reasoning
# xAI 搜索提供商超时（秒）
XAI_WEB_SEARCH_TIMEOUT_SECONDS=45
# SearXNG 实例地址（仅 WEB_SEARCH_PROVIDER=searxng 时）
SEARXNG_URL=http://localhost:8888
# 调优参数
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_CACHE_TTL_SECONDS=300
# 打开后，首页高级设置会显示 4 个来源复选框：
# 预测市场 / 财经资讯 / 学术文献 / 深度报道。
# 需要搜索增强和支持域名过滤的搜索提供商才能真正生效。
FEATURE_NEW_SOURCES=false
# 只有已配置搜索服务并使用来源复选框时再打开。
FEATURE_FAMILY_QUERY_OPTIMIZATION=false
