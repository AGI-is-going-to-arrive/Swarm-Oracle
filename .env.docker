# Docker Compose runtime defaults.
# docker-compose.yml overrides database paths to use the /data volume.
#
# ── LLM Configuration ────────────────────────────────
# Host-machine LLM endpoint as seen from the Docker container.
LLM_RESPONSES_URL=http://host.docker.internal:8317/v1
# Your API key.
LLM_API_KEY=your-api-key-here
# Model name.
LLM_MODEL_NAME=gpt-4o
LLM_REASONING_EFFORT=none
LLM_REQUESTS_PER_MINUTE=0
LLM_TOKENS_PER_MINUTE=0

# ── Simulation Parameters ────────────────────────────
MAX_AGENTS=1500
MAX_ROUNDS=40
MAX_BRANCHES=8
MEMORY_COMPRESS_INTERVAL=5
BRANCH_PRUNE_THRESHOLD=0.05
FORK_SENSITIVITY=0.7
DEFAULT_NUM_AGENTS=20
DEFAULT_ROUNDS=10

# ── Concurrency ──────────────────────────────────────
LLM_CONCURRENCY=5
LLM_MAX_PENDING=24
LLM_USER_MAX_PENDING=4
LLM_CIRCUIT_BREAKER_THRESHOLD=6
LLM_CIRCUIT_BREAKER_RESET_SECONDS=30
DEBATE_USE_LLM=true

# ── Database ─────────────────────────────────────────
DATABASE_URL=sqlite:///./swarmoracle.db
CHROMA_PERSIST_DIR=./chroma_data

# ── Server ───────────────────────────────────────────
HOST=0.0.0.0
PORT=18927
CORS_ORIGINS=["http://localhost","http://127.0.0.1","http://localhost:18928","http://127.0.0.1:18928"]

# ── Security: Session Gate and Admin Endpoints ───────
# Set both values before exposing Docker deployment outside this machine.
# REST endpoints then require X-Session-Token; WebSocket auth uses the first
# frame: {"type":"auth","token":"..."}.
SESSION_SECRET=
# /api/admin/* requires X-Admin-Token when this value is set.
ADMIN_TOKEN=

# ── Phase 3 Feature Flags ────────────────────────────
# Default-on user-facing features.
FEATURE_CUSTOM_AGENTS=true
FEATURE_AGENT_IDENTITY=true
FEATURE_CAUSAL_GRAPH=true
FEATURE_GRAPH_ANALYSIS=true
FEATURE_COUNTERFACTUAL_REPLAY=true
FEATURE_FACTIONS=true
FEATURE_ARGUMENT_MAP=true
FEATURE_KG_EXPLORER=true
FEATURE_REPLAY_TRACE=true
FEATURE_AGENT_CONVERSATION=true
FEATURE_ROUNDTABLE_SURVEY=true
FEATURE_ROUNDTABLE_ANALYST=true
FEATURE_SNAPSHOT_EXPORT=true
FEATURE_PREDICTION_JOURNAL=true
FEATURE_RESULT_VERDICT=true
FEATURE_EDUCATION_TEMPLATES=true
FEATURE_PERSONA_EXPORT=true

# Backend-only behavior flags stay off by default.
FEATURE_ROUNDTABLE_INSIGHT_LLM=false
FEATURE_HALLUCINATION_GATE=false
FEATURE_IDENTITY_COMPACTION=false

# ── Web Search Enhancement ───────────────────────────
# Set true only after configuring a search provider. Hosted providers usually
# need WEB_SEARCH_API_KEY; searxng needs a reachable SEARXNG_URL.
ENABLE_WEB_SEARCH=false
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
XAI_WEB_SEARCH_MODEL=grok-4.20-reasoning
XAI_WEB_SEARCH_TIMEOUT_SECONDS=45
SEARXNG_URL=http://localhost:8888
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_CACHE_TTL_SECONDS=300
# When enabled, the home-page advanced settings show four domain-source
# checkboxes: prediction market, finance, academic, and deep news.
# They only work with search enabled and a provider that supports domain filters.
FEATURE_NEW_SOURCES=false
# Enable only after search is configured and source-family filters are in use.
FEATURE_FAMILY_QUERY_OPTIMIZATION=false
