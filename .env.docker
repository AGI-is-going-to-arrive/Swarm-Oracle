# Docker Compose runtime defaults.
# docker-compose.yml overrides database paths to use the /data volume.
#
# ── LLM Configuration ────────────────────────────────
# Docker 内访问宿主机 LLM 服务
LLM_RESPONSES_URL=http://host.docker.internal:8317/v1
# 你的 API Key
LLM_API_KEY=your-api-key-here
# 模型名称
LLM_MODEL_NAME=gpt-4o
LLM_REASONING_EFFORT=none
LLM_REQUESTS_PER_MINUTE=0
LLM_TOKENS_PER_MINUTE=0

# ── Simulation Parameters ────────────────────────────
MAX_AGENTS=1500
MAX_ROUNDS=40
MAX_BRANCHES=8
MEMORY_COMPRESS_INTERVAL=5
BRANCH_PRUNE_THRESHOLD=0.05
FORK_SENSITIVITY=0.7
DEFAULT_NUM_AGENTS=20
DEFAULT_ROUNDS=10

# ── Concurrency ──────────────────────────────────────
LLM_CONCURRENCY=5
LLM_MAX_PENDING=24
LLM_USER_MAX_PENDING=4
LLM_CIRCUIT_BREAKER_THRESHOLD=6
LLM_CIRCUIT_BREAKER_RESET_SECONDS=30
DEBATE_USE_LLM=true

# ── Database ─────────────────────────────────────────
DATABASE_URL=sqlite:///./swarmoracle.db
CHROMA_PERSIST_DIR=./chroma_data

# ── Server ───────────────────────────────────────────
HOST=0.0.0.0
PORT=18927
CORS_ORIGINS=["http://localhost","http://127.0.0.1","http://localhost:18928","http://127.0.0.1:18928"]

# ── Phase 3 Feature Flags ────────────────────────────
FEATURE_COUNTERFACTUAL_REPLAY=true
FEATURE_CAUSAL_GRAPH=true
FEATURE_FACTIONS=true
FEATURE_ARGUMENT_MAP=true
